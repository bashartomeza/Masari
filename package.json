{
  "name": "masari",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @masari/api",
    "dev:admin": "npm run dev -w @masari/admin",
    "build": "npm run build --workspaces",
    "build:api": "npm run build -w @masari/api",
    "build:admin": "npm run build -w @masari/admin",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:api": "npm run typecheck -w @masari/api",
    "typecheck:admin": "npm run typecheck -w @masari/admin",
    "test": "npm run test -w @masari/api",
    "test:admin": "npm run test -w @masari/admin",
    "demo:preflight": "node scripts/demo-preflight.mjs",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "prisma:generate": "npm run prisma:generate -w @masari/api",
    "prisma:validate": "npm run prisma:validate -w @masari/api",
    "db:push": "npm run db:push -w @masari/api"
  },
  "engines": {
    "node": ">=22.17.1",
    "npm": ">=10.9.2"
  }
}
