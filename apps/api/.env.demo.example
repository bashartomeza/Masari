JWT_SECRET="<at-least-32-random-characters>"
ACCESS_TOKEN_TTL_SECONDS="28800"
REFRESH_TOKEN_TTL_DAYS="30"
REFRESH_TOKEN_PEPPER="<at-least-32-random-characters-separate-from-jwt>"
CORS_ORIGINS="http://localhost:5173"
TRUST_PROXY="none"
LOG_LEVEL="info"
DEMO_RESET_KEY="<demo-only-reset-key>"
DEMO_PASSENGER_PASSWORD="<demo-only-passenger-password>"
DEMO_DRIVER_PASSWORD="<demo-only-driver-password>"
DEMO_MERCHANT_PASSWORD="<demo-only-merchant-password>"
