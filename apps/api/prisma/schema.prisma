  driver_route DriverRoute @relation(fields: [driver_route_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  manifest CanonicalTripManifest @relation(fields: [manifest_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  match_offer Match @relation(fields: [match_offer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([dispatch_id, driver_route_id], map: "canonical_attempt_candidate_exclusion_key")
  @@unique([dispatch_id, attempt_number], map: "canonical_attempt_sequence_key")
  @@index([manifest_id, outcome])
  @@map("canonical_demand_attempts")
}

model LocationEvent {
  id          String   @id @default(cuid())
  trip_id     String
  driver_id   String
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  source      String
  sequence    Int
  recorded_at DateTime @default(now())

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id, sequence])
  @@map("location_events")
}

model DemoScenario {
  id           String   @id @default(cuid())
  scenario_key String   @unique
  corridor_key String
  description  String   @db.Text
  seed_version String
  created_at   DateTime @default(now())

  @@map("demo_scenarios")
}

model AuditEvent {
  id          String      @id @default(cuid())
  user_id     String?
  action      AuditAction
  entity_type String?
  entity_id   String?
  metadata    Json?
  created_at  DateTime    @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([user_id])
  @@map("audit_events")
}
