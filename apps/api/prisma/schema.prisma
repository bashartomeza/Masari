generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  passenger
  driver
  merchant
  admin
}

enum AccountStatus {
  active
  pending
  suspended
  disabled
}

enum DriverVerificationStatus {
  pending
  approved
  rejected
}

enum AuthClientType {
  mobile
  admin
}

enum DriverRouteStatus {
  inactive
  active
  assigned
  on_trip
  completed
}

enum RouteDirection {
  outbound
  inbound
  loop
}

enum ServiceRouteStatus {
  active
  retired
}

enum ServiceRouteVersionStatus {
  draft
  published
  paused
  retired
}

enum RouteGeometryStatus {
  pending
  available
  unavailable
}

enum StopStatus {
  active
  retired
}

enum DriverAvailabilityStatus {
  draft
  active
  paused
  filled
  departed
  completed
  cancelled
  expired
}

enum CapacityReservationType {
  passenger
  parcel
  combined
}

enum CapacityReservationStatus {
  held
  confirmed
  released
  expired
}

enum RequestStatus {
  draft
  pending
  matched
  accepted
  picked_up
  in_transit
  delivered
  cancelled
}

enum MerchantOrderStatus {
  draft
  submitted
  batched
  assigned
  in_transit
  completed
}

enum ParcelStatus {
  pending
  batched
  assigned
  picked_up
  in_transit
  delivered
}

enum ParcelBatchStatus {
  created
  proposed
  assigned
  picked_up
  in_transit
  delivered
}

enum MatchStatus {
  proposed
  sent_to_driver
  accepted
  rejected
  expired
  invalidated
}

enum CanonicalDemandType {
  passenger
  merchant_order
}

enum CanonicalDispatchStatus {
  pending
  offered
  assigned
  cancelled
  unavailable
}

enum CanonicalRejectReason {
  driver_declined
  schedule_conflict
  capacity_unavailable
}

enum CanonicalManifestStatus {
  building
  offered
  accepted
  rejected
  expired
  dissolved
}

enum CanonicalManifestMemberStatus {
  active
  accepted
  released
  invalidated
}

enum CanonicalAttemptOutcome {
  offered
  rejected
  expired
  system_invalidated
}

enum TripStatus {
  created
  accepted
  pickup_started
  picked_up
  in_transit
  delivered
  completed
  cancelled
}

enum AuditAction {
  auth_login
  session_created
  session_refreshed
  session_revoked
  logout_all
  refresh_token_reuse_detected
  account_status_changed
  login_blocked_by_status
  demo_reset
  passenger_request_created
  passenger_request_cancelled
  driver_route_created
  driver_route_deactivated
  merchant_order_created
  parcel_batch_created
  comparison_run_created
  match_accepted
  match_rejected
  trip_status_updated
  location_recorded
  tracking_simulation_step
  driver_verification
  match_decision
  admin_action
  invitation_created
  invitation_revoked
  invitation_redeemed
  otp_challenge_created
  otp_verified
  consent_recorded
  invitation_consumed
  onboarding_attempt_created
  otp_dispatch_accepted
  otp_dispatch_rejected
  otp_verification_failed
  onboarding_session_created
  onboarding_session_revoked
  consent_document_created
  abuse_limit_reached
  idempotency_conflict
  onboarding_started
  onboarding_resumed
  otp_resent
  registration_completed
  registration_completion_failed
  pending_status_session_created
  onboarding_status_accessed
  onboarding_rate_limited
  onboarding_idempotency_conflict
  route_created
  route_version_created
  route_draft_updated
  route_stops_updated
  route_version_published
  route_version_paused
  route_version_resumed
  route_version_retired
  route_retired
  stop_created
  stop_updated
  stop_retired
  driver_availability_created
  driver_availability_updated
  driver_availability_status_changed
  driver_availability_activated
  driver_availability_paused
  driver_availability_resumed
  driver_availability_cancelled
  canonical_passenger_request_created
  canonical_merchant_order_created
  capacity_reserved
  capacity_confirmed
  capacity_released
  capacity_expired
  canonical_matching_run_started
  canonical_matching_run_completed
  canonical_offer_created
  canonical_offer_accepted
  canonical_offer_rejected
  canonical_offer_expired
  canonical_offer_reassigned
  canonical_trip_created
  canonical_dispatch_unavailable
  canonical_manifest_created
  canonical_manifest_offered
  canonical_manifest_accepted
  canonical_manifest_rejected
  canonical_manifest_expired
  canonical_manifest_invalidated
  canonical_manifest_regrouped
  canonical_shared_trip_created
}

enum OnboardingRole {
  passenger
  driver
  merchant
}

enum OnboardingAttemptStatus {
  created
  otp_dispatching
  otp_sent
  phone_verified
  completed
  expired
  locked
  cancelled
}

enum OtpDeliveryStatus {
  dispatching
  accepted
  rejected
  unknown
}

enum OtpPurpose {
  registration
}

enum OnboardingSessionPurpose {
  onboarding_completion
  continuation
  pending_status
}

enum ConsentDocumentType {
  terms
  privacy
  adult_self_attestation
}

enum ConsentLocale {
  ar
  en
}

enum ConsentReleaseStatus {
  draft
  approved
  effective
  retired
}

enum IdempotencyState {
  processing
  completed
  failed
}

model User {
  id                String        @id @default(cuid())
  name              String
  phone             String        @unique
  password_hash     String
  role              UserRole
  account_status    AccountStatus @default(active)
  security_version  Int           @default(1)
  status_reason     String?       @db.VarChar(500)
  status_updated_at DateTime      @default(now())
  last_login_at     DateTime?
  demo_account      Boolean       @default(false)
  created_at        DateTime      @default(now())

  driver_profile                   DriverProfile?
  driver_verification              DriverVerification?  @relation("DriverVerificationApplicant")
  driver_verification_reviews      DriverVerification[]  @relation("DriverVerificationReviewer")
  passenger_requests               PassengerRequest[]
  merchant_orders                  MerchantOrder[]
  audit_events                     AuditEvent[]
  auth_sessions                    AuthSession[]
  invitations_created              Invitation[]           @relation("InvitationCreator")
  invitations_revoked              Invitation[]           @relation("InvitationRevoker")
  invitation_redemptions           InvitationRedemption[]
  onboarding_attempts              OnboardingAttempt[]    @relation("CompletedOnboardingUser")
  onboarding_sessions              OnboardingSession[]
  consents                         UserConsent[]
  service_routes_created           ServiceRoute[]         @relation("ServiceRouteCreator")
  service_routes_retired           ServiceRoute[]         @relation("ServiceRouteRetirer")
  service_route_versions_created   ServiceRouteVersion[]  @relation("ServiceRouteVersionCreator")
  service_route_versions_published ServiceRouteVersion[]  @relation("ServiceRouteVersionPublisher")
  service_route_versions_paused    ServiceRouteVersion[]  @relation("ServiceRouteVersionPauser")
  service_route_versions_retired   ServiceRouteVersion[]  @relation("ServiceRouteVersionRetirer")
  stops_created                    Stop[]                 @relation("StopCreator")
  stops_retired                    Stop[]                 @relation("StopRetirer")

  @@map("users")
}

model Invitation {
  id                    String         @id @default(cuid())
  code_digest           String         @unique @db.Char(64)
  code_key_version      Int
  intended_role         OnboardingRole
  intended_phone_digest String         @db.Char(64)
  phone_digest_version  Int
  phone_last4           String         @db.Char(4)
  campaign              String?        @db.VarChar(100)
  source                String?        @db.VarChar(100)
  metadata              Json?
  max_uses              Int            @default(1)
  used_count            Int            @default(0)
  expires_at            DateTime
  revoked_at            DateTime?
  revoke_reason         String?        @db.VarChar(500)
  created_by_id         String
  revoked_by_id         String?
  last_used_at          DateTime?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  created_by  User                   @relation("InvitationCreator", fields: [created_by_id], references: [id], onDelete: Restrict)
  revoked_by  User?                  @relation("InvitationRevoker", fields: [revoked_by_id], references: [id], onDelete: SetNull)
  redemptions InvitationRedemption[]
  attempt     OnboardingAttempt?

  @@index([created_at])
  @@index([expires_at, revoked_at])
  @@index([intended_role, created_at])
  @@map("invitations")
}

model InvitationRedemption {
  id                    String   @id @default(cuid())
  invitation_id         String
  onboarding_attempt_id String   @unique
  user_id               String?
  redeemed_at           DateTime @default(now())

  invitation         Invitation        @relation(fields: [invitation_id], references: [id], onDelete: Cascade)
  onboarding_attempt OnboardingAttempt @relation(fields: [onboarding_attempt_id], references: [id], onDelete: Cascade)
  user               User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([invitation_id, redeemed_at])
  @@map("invitation_redemptions")
}

model OnboardingAttempt {
  id                             String                  @id @default(cuid())
  invitation_id                  String                  @unique
  intended_role                  OnboardingRole
  phone_e164                     String                  @db.VarChar(32)
  phone_digest                   String                  @db.Char(64)
  phone_digest_version           Int
  phone_last4                    String                  @db.Char(4)
  status                         OnboardingAttemptStatus @default(created)
  current_challenge_id           String?                 @unique
  completed_user_id              String?
  request_ip_digest              String?                 @db.Char(64)
  request_ip_digest_version      Int?
  created_request_id             String?                 @db.VarChar(64)
  expires_at                     DateTime
  verified_at                    DateTime?
  registration_grant_digest      String?                 @db.Char(64)
  registration_grant_key_version Int?
  registration_grant_expires_at  DateTime?
  otp_dispatch_claim_id          String?                 @db.VarChar(36)
  otp_dispatch_started_at        DateTime?
  completed_at                   DateTime?
  created_at                     DateTime                @default(now())
  updated_at                     DateTime                @updatedAt

  invitation        Invitation            @relation(fields: [invitation_id], references: [id], onDelete: Cascade)
  current_challenge OtpChallenge?         @relation("CurrentOtpChallenge", fields: [current_challenge_id], references: [id], onDelete: SetNull)
  otp_challenges    OtpChallenge[]        @relation("AttemptOtpChallenges")
  completed_user    User?                 @relation("CompletedOnboardingUser", fields: [completed_user_id], references: [id], onDelete: SetNull)
  redemption        InvitationRedemption?
  sessions          OnboardingSession[]

  @@index([phone_digest, status])
  @@index([invitation_id, created_at])
  @@index([expires_at])
  @@map("onboarding_attempts")
}

model OtpChallenge {
  id                    String            @id @default(cuid())
  onboarding_attempt_id String
  generation            Int
  purpose               OtpPurpose        @default(registration)
  provider              String            @db.VarChar(50)
  code_digest           String            @db.Char(64)
  code_key_version      Int
  delivery_status       OtpDeliveryStatus @default(dispatching)
  provider_message_id   String?           @db.VarChar(191)
  attempt_count         Int               @default(0)
  max_attempts          Int
  expires_at            DateTime
  consumed_at           DateTime?
  superseded_at         DateTime?
  last_sent_at          DateTime?
  locked_until          DateTime?
  delivery_updated_at   DateTime
  request_id            String?           @db.VarChar(64)
  created_at            DateTime          @default(now())

  onboarding_attempt  OnboardingAttempt  @relation("AttemptOtpChallenges", fields: [onboarding_attempt_id], references: [id], onDelete: Cascade)
  current_for_attempt OnboardingAttempt? @relation("CurrentOtpChallenge")

  @@unique([onboarding_attempt_id, generation])
  @@index([onboarding_attempt_id, expires_at])
  @@map("otp_challenges")
}

model OnboardingSession {
  id                    String                   @id @default(cuid())
  onboarding_attempt_id String
  user_id               String?
  token_digest          String                   @unique @db.Char(64)
  token_key_version     Int
  purpose               OnboardingSessionPurpose @default(onboarding_completion)
  expires_at            DateTime
  last_used_at          DateTime?
  consumed_at           DateTime?
  revoked_at            DateTime?
  revoke_reason         String?                  @db.VarChar(191)
  created_at            DateTime                 @default(now())

  onboarding_attempt OnboardingAttempt @relation(fields: [onboarding_attempt_id], references: [id], onDelete: Cascade)
  user               User?             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([onboarding_attempt_id, expires_at])
  @@index([user_id, revoked_at, expires_at])
  @@map("onboarding_sessions")
}

model ConsentRelease {
  id                    String               @id @default(cuid())
  version               String               @unique @db.VarChar(50)
  status                ConsentReleaseStatus @default(draft)
  revision              Int                  @default(1)
  intended_effective_at DateTime
  legal_approved_at     DateTime?
  legal_approved_by     String?              @db.VarChar(191)
  activated_at          DateTime?
  activated_by          String?              @db.VarChar(191)
  retired_at            DateTime?
  retired_by            String?              @db.VarChar(191)
  retirement_reason     String?              @db.VarChar(500)
  created_by            String               @db.VarChar(191)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt

  documents ConsentDocument[]

  @@index([status, intended_effective_at])
  @@map("consent_releases")
}

model ConsentDocument {
  id                String              @id @default(cuid())
  release_id        String?
  document_type     ConsentDocumentType
  version           String              @db.VarChar(50)
  locale            ConsentLocale
  content_body      String?             @db.Text
  content_digest    String              @db.Char(64)
  content_reference String?             @db.VarChar(500)
  effective_at      DateTime
  retired_at        DateTime?
  legal_approved_at DateTime?
  legal_approved_by String?             @db.VarChar(191)
  created_at        DateTime            @default(now())

  release  ConsentRelease? @relation(fields: [release_id], references: [id], onDelete: Restrict)
  consents UserConsent[]

  @@unique([document_type, version, locale])
  @@unique([release_id, document_type, locale])
  @@index([document_type, locale, effective_at])
  @@map("consent_documents")
}

model UserConsent {
  id                  String   @id @default(cuid())
  user_id             String
  consent_document_id String
  accepted_at         DateTime @default(now())
  request_id          String?  @db.VarChar(64)
  ip_digest           String?  @db.Char(64)
  ip_digest_version   Int?
  source              String   @db.VarChar(50)
  app_release         String?  @db.VarChar(100)

  user             User            @relation(fields: [user_id], references: [id], onDelete: Restrict, map: "user_consents_user_id_restrict_fkey")
  consent_document ConsentDocument @relation(fields: [consent_document_id], references: [id], onDelete: Restrict)

  @@unique([user_id, consent_document_id])
  @@index([consent_document_id, accepted_at])
  @@map("user_consents")
}

model AbuseCounter {
  id             String   @id @default(cuid())
  bucket_type    String   @db.VarChar(50)
  subject_digest String   @db.Char(64)
  digest_version Int
  window_start   DateTime
  window_seconds Int
  count          Int      @default(0)
  expires_at     DateTime
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([bucket_type, subject_digest, digest_version, window_start, window_seconds])
  @@index([window_start])
  @@map("abuse_counters")
}

model IdempotencyRecord {
  id              String           @id @default(cuid())
  operation       String           @db.VarChar(80)
  scope_digest    String           @db.Char(64)
  idempotency_key String           @db.Char(64)
  key_version     Int
  request_digest  String           @db.Char(64)
  claim_version   Int              @default(1)
  state           IdempotencyState @default(processing)
  resource_type   String?          @db.VarChar(80)
  resource_id     String?          @db.VarChar(191)
  response_status Int?
  completed_at    DateTime?
  failed_at       DateTime?
  expires_at      DateTime
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@unique([operation, scope_digest, idempotency_key, key_version], map: "idempotency_claim_key")
  @@index([expires_at])
  @@map("idempotency_records")
}

model AuthSession {
  id                        String         @id @default(cuid())
  user_id                   String
  client_type               AuthClientType
  device_name               String?        @db.VarChar(120)
  created_at                DateTime       @default(now())
  last_used_at              DateTime       @default(now())
  expires_at                DateTime
  revoked_at                DateTime?
  revoke_reason             String?        @db.VarChar(191)
  security_version_at_issue Int

  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@index([user_id, revoked_at, expires_at])
  @@index([expires_at])
  @@map("auth_sessions")
}

model RefreshToken {
  id             String    @id
  session_id     String
  token_hash     String    @unique @db.Char(64)
  created_at     DateTime  @default(now())
  expires_at     DateTime
  used_at        DateTime?
  revoked_at     DateTime?
  replaced_by_id String?   @unique

  session     AuthSession    @relation(fields: [session_id], references: [id], onDelete: Cascade)
  replaced_by RefreshToken?  @relation("RefreshTokenRotation", fields: [replaced_by_id], references: [id], onDelete: SetNull)
  replaces    RefreshToken[] @relation("RefreshTokenRotation")

  @@index([session_id, revoked_at, expires_at])
  @@index([session_id, used_at, revoked_at])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model DriverProfile {
  id              String   @id @default(cuid())
  user_id         String   @unique
  vehicle_type    String
  seats_total     Int
  parcel_capacity Int
  verified        Boolean  @default(false)
  trust_score     Int      @default(70)
  created_at      DateTime @default(now())

  user   User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  routes DriverRoute[]

  @@map("driver_profiles")
}

model DriverVerification {
  id               String                   @id @default(cuid())
  user_id          String                   @unique
  status           DriverVerificationStatus @default(pending)
  rejection_reason String?                  @db.VarChar(500)
  revision         Int                      @default(1)
  submitted_at     DateTime                 @default(now())
  reviewed_at      DateTime?
  reviewed_by_id   String?
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt

  user        User  @relation("DriverVerificationApplicant", fields: [user_id], references: [id], onDelete: Cascade)
  reviewed_by User? @relation("DriverVerificationReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)

  @@index([status, submitted_at])
  @@index([reviewed_by_id])
  @@map("driver_verifications")
}

model DriverRoute {
  id                        String                    @id @default(cuid())
  driver_id                 String
  origin_label              String
  origin_lat                Decimal                   @db.Decimal(9, 6)
  origin_lng                Decimal                   @db.Decimal(9, 6)
  destination_label         String
  destination_lat           Decimal                   @db.Decimal(9, 6)
  destination_lng           Decimal                   @db.Decimal(9, 6)
  corridor_key              String
  seats_available           Int
  parcel_capacity_available Int
  status                    DriverRouteStatus         @default(inactive)
  route_version_id          String?
  departure_at              DateTime?
  availability_window_end   DateTime?
  total_seats               Int?
  remaining_seats           Int?
  total_parcel_capacity     Int?
  remaining_parcel_capacity Int?
  availability_status       DriverAvailabilityStatus?
  canonical_availability_version String?              @db.VarChar(50)
  operational_mode          String                    @default("legacy") @db.VarChar(50)
  availability_revision     Int                       @default(1)
  activated_at              DateTime?
  paused_at                 DateTime?
  filled_at                 DateTime?
  departed_at               DateTime?
  completed_at              DateTime?
  cancelled_at              DateTime?
  expired_at                DateTime?

  driver         DriverProfile        @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  route_version  ServiceRouteVersion? @relation(fields: [route_version_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parcel_batches ParcelBatch[]
  matches        Match[]
  trips          Trip[]
  capacity_reservations CapacityReservation[]
  canonical_matches Match[] @relation("CanonicalOfferAvailability")
  mode_matches Match[] @relation("MatchAvailabilityMode")
  mode_trips Trip[] @relation("TripAvailabilityMode")
  canonical_manifests CanonicalTripManifest[]
  canonical_attempts CanonicalDemandAttempt[]

  @@index([corridor_key])
  @@index([route_version_id, availability_status, departure_at])
  @@index([canonical_availability_version, availability_status, departure_at])
  @@unique([id, route_version_id], map: "driver_routes_route_ownership_key")
  @@unique([id, operational_mode], map: "driver_routes_mode_ownership_key")
  @@unique([id, route_version_id, operational_mode], map: "driver_routes_route_mode_ownership_key")
  @@unique([driver_id, route_version_id, departure_at], map: "driver_routes_one_off_departure_key")
  @@map("driver_routes")
}

model Stop {
  id                 String     @id @default(cuid())
  stop_key           String     @unique @db.VarChar(80)
  service_region_key String     @db.VarChar(80)
  name_ar            String     @db.VarChar(160)
  name_en            String     @db.VarChar(160)
  latitude           Decimal    @db.Decimal(9, 6)
  longitude          Decimal    @db.Decimal(9, 6)
  status             StopStatus @default(active)
  created_by_user_id String
  retired_by_user_id String?
  retired_at         DateTime?
  retirement_reason  String?    @db.VarChar(500)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  created_by               User                  @relation("StopCreator", fields: [created_by_user_id], references: [id], onDelete: Restrict)
  retired_by               User?                 @relation("StopRetirer", fields: [retired_by_user_id], references: [id], onDelete: SetNull)
  origin_for_versions      ServiceRouteVersion[] @relation("OriginStop")
  destination_for_versions ServiceRouteVersion[] @relation("DestinationStop")
  version_memberships      RouteVersionStop[]

  @@index([service_region_key, status])
  @@map("stops")
}

model ServiceRoute {
  id                 String             @id @default(cuid())
  route_key          String             @unique @db.VarChar(80)
  route_group_key    String             @db.VarChar(80)
  service_region_key String             @db.VarChar(80)
  direction          RouteDirection
  status             ServiceRouteStatus @default(active)
  current_version_id String?            @unique
  created_by_user_id String
  retired_by_user_id String?
  retired_at         DateTime?
  retirement_reason  String?            @db.VarChar(500)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  created_by      User                  @relation("ServiceRouteCreator", fields: [created_by_user_id], references: [id], onDelete: Restrict)
  retired_by      User?                 @relation("ServiceRouteRetirer", fields: [retired_by_user_id], references: [id], onDelete: SetNull)
  versions        ServiceRouteVersion[] @relation("ServiceRouteVersions")
  current_version ServiceRouteVersion?  @relation("CurrentServiceRouteVersion", fields: [id, current_version_id], references: [service_route_id, id], onDelete: Restrict)

  @@unique([id, current_version_id], map: "service_routes_owned_current_key")
  @@index([route_group_key, direction])
  @@index([service_region_key, status])
  @@map("service_routes")
}

model ServiceRouteVersion {
  id                         String                    @id @default(cuid())
  service_route_id           String
  version_number             Int
  status                     ServiceRouteVersionStatus @default(draft)
  name_ar                    String                    @db.VarChar(160)
  name_en                    String                    @db.VarChar(160)
  description_ar             String?                   @db.Text
  description_en             String?                   @db.Text
  origin_stop_id             String?
  destination_stop_id        String?
  active_from                DateTime?
  active_until               DateTime?
  encoded_geometry           String?                   @db.LongText
  geometry_encoding          String?                   @db.VarChar(50)
  geometry_provider          String?                   @db.VarChar(80)
  geometry_checksum          String?                   @db.Char(64)
  geometry_precision         Int?
  estimated_distance_meters  Int?
  estimated_duration_seconds Int?
  geometry_status            RouteGeometryStatus       @default(pending)
  draft_revision             Int                       @default(1)
  created_by_user_id         String
