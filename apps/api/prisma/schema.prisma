model Match {
  id                   String      @id @default(cuid())
  driver_route_id      String
  passenger_request_id String?
  merchant_order_id    String?
  parcel_batch_id      String?
  score                Decimal     @db.Decimal(5, 4)
  method               String
  explanation          String      @db.Text
  scoring_breakdown    Json
  status               MatchStatus @default(proposed)
  created_at           DateTime    @default(now())
  route_version_id     String?
  canonical_match_version String?  @db.VarChar(50)
  operational_mode     String      @default("legacy") @db.VarChar(50)
  dispatch_id          String?
  reservation_id       String?     @unique
  attempt_number       Int?
  offered_at           DateTime?
  expires_at           DateTime?
  accepted_at          DateTime?
  rejected_at          DateTime?
  expired_at           DateTime?
  reject_reason        CanonicalRejectReason?
  score_version        String?     @db.VarChar(50)
  active_dispatch_key  String?     @unique @db.VarChar(191)
  accepted_dispatch_key String?    @unique @db.VarChar(191)
  demand_checksum       String?    @db.Char(64)
  active_driver_route_key String?  @unique @db.VarChar(191)
  accepted_driver_route_key String? @unique @db.VarChar(191)
  canonical_assignment_key String? @db.Char(64)
  expiry_failure_count Int         @default(0)
  expiry_last_failed_at DateTime?

  driver_route      DriverRoute       @relation(fields: [driver_route_id], references: [id], onDelete: Restrict)
  mode_driver_route DriverRoute       @relation("MatchAvailabilityMode", fields: [driver_route_id, operational_mode], references: [id, operational_mode], onDelete: Restrict, onUpdate: Restrict)
  canonical_driver_route DriverRoute? @relation("CanonicalOfferAvailability", fields: [driver_route_id, route_version_id, operational_mode], references: [id, route_version_id, operational_mode], onDelete: Restrict, onUpdate: Restrict)
  passenger_request PassengerRequest? @relation(fields: [passenger_request_id], references: [id], onDelete: Restrict)
  merchant_order    MerchantOrder?    @relation(fields: [merchant_order_id], references: [id], onDelete: Restrict)
  parcel_batch      ParcelBatch?      @relation(fields: [parcel_batch_id], references: [id], onDelete: Restrict)
  route_version     ServiceRouteVersion? @relation(fields: [route_version_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  capacity_reservation CapacityReservation? @relation("ReservationMatch")
  offer_reservation CapacityReservation? @relation("OfferReservation", fields: [reservation_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dispatch CanonicalDemandDispatch? @relation("DispatchOffers", fields: [dispatch_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  active_for_dispatches CanonicalDemandDispatch[] @relation("ActiveDispatchOffer")
  canonical_trip Trip? @relation("CanonicalTripOffer")
  canonical_manifest CanonicalTripManifest? @relation("ManifestOffer", fields: [manifest_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  active_for_manifest CanonicalTripManifest? @relation("ActiveManifestOffer")
  accepted_for_manifest CanonicalTripManifest? @relation("AcceptedManifestOffer")
  canonical_attempts CanonicalDemandAttempt[]

  manifest_id String? @unique
  active_manifest_key String? @unique
  accepted_manifest_key String? @unique

  @@index([route_version_id, status])
  @@index([dispatch_id, status])
  @@index([status, expires_at, expiry_failure_count], map: "matches_canonical_expiry_idx")
  @@unique([dispatch_id, attempt_number], map: "matches_dispatch_attempt_key")
  @@unique([id, route_version_id], map: "matches_route_ownership_key")
  @@unique([id, operational_mode], map: "matches_mode_ownership_key")
  @@unique([id, active_dispatch_key], map: "matches_active_dispatch_ownership_key")
  @@unique([id, canonical_assignment_key], map: "matches_assignment_ownership_key")
  @@unique([id, manifest_id], map: "matches_manifest_ownership_key")
  @@unique([id, active_manifest_key], map: "matches_active_manifest_ownership_key")
  @@unique([id, accepted_manifest_key], map: "matches_accepted_manifest_ownership_key")
  @@map("matches")
}

