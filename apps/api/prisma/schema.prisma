  @@index([route_version_id, status])
  @@unique([id, operational_mode], map: "trips_mode_ownership_key")
  @@unique([canonical_match_id, canonical_assignment_key], map: "trips_match_assignment_key")
  @@unique([id, canonical_dispatch_id], map: "trips_dispatch_ownership_key")
  @@unique([id, manifest_id], map: "trips_manifest_ownership_key")
  @@map("trips")
}

