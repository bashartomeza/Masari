generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  passenger
  driver
  merchant
  admin
}

enum AccountStatus {
  active
  pending
  suspended
  disabled
}

enum AuthClientType {
  mobile
  admin
}

enum DriverRouteStatus {
  inactive
  active
  assigned
  on_trip
  completed
}

enum RequestStatus {
  draft
  pending
  matched
  accepted
  picked_up
  in_transit
  delivered
  cancelled
}

enum MerchantOrderStatus {
  draft
  submitted
  batched
  assigned
  in_transit
  completed
}

enum ParcelStatus {
  pending
  batched
  assigned
  picked_up
  in_transit
  delivered
}

enum ParcelBatchStatus {
  created
  proposed
  assigned
  picked_up
  in_transit
  delivered
}

enum MatchStatus {
  proposed
  sent_to_driver
  accepted
  rejected
  expired
}

enum TripStatus {
  created
  accepted
  pickup_started
  picked_up
  in_transit
  delivered
  completed
  cancelled
}

enum AuditAction {
  auth_login
  session_created
  session_refreshed
  session_revoked
  logout_all
  refresh_token_reuse_detected
  account_status_changed
  login_blocked_by_status
  demo_reset
  passenger_request_created
  passenger_request_cancelled
  driver_route_created
  driver_route_deactivated
  merchant_order_created
  parcel_batch_created
  comparison_run_created
  match_accepted
  match_rejected
  trip_status_updated
  location_recorded
  tracking_simulation_step
  driver_verification
  match_decision
  admin_action
}

model User {
  id                String        @id @default(cuid())
  name              String
  phone             String        @unique
  password_hash     String
  role              UserRole
  account_status    AccountStatus @default(active)
  security_version  Int           @default(1)
  status_reason     String?       @db.VarChar(500)
  status_updated_at DateTime      @default(now())
  last_login_at     DateTime?
  demo_account      Boolean       @default(false)
  created_at        DateTime      @default(now())

  driver_profile DriverProfile?
  passenger_requests PassengerRequest[]
  merchant_orders MerchantOrder[]
  audit_events    AuditEvent[]
  auth_sessions   AuthSession[]

  @@map("users")
}

model AuthSession {
  id                        String         @id @default(cuid())
  user_id                   String
  client_type               AuthClientType
  device_name               String?        @db.VarChar(120)
  created_at                DateTime       @default(now())
  last_used_at              DateTime       @default(now())
  expires_at                DateTime
  revoked_at                DateTime?
  revoke_reason             String?        @db.VarChar(191)
  security_version_at_issue Int

  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@index([user_id, revoked_at, expires_at])
  @@index([expires_at])
  @@map("auth_sessions")
}

model RefreshToken {
  id             String   @id
  session_id     String
  token_hash     String   @unique @db.Char(64)
  created_at     DateTime @default(now())
  expires_at     DateTime
  used_at        DateTime?
  revoked_at     DateTime?
  replaced_by_id String?  @unique

  session     AuthSession    @relation(fields: [session_id], references: [id], onDelete: Cascade)
  replaced_by RefreshToken?  @relation("RefreshTokenRotation", fields: [replaced_by_id], references: [id], onDelete: SetNull)
  replaces    RefreshToken[] @relation("RefreshTokenRotation")

  @@index([session_id, revoked_at, expires_at])
  @@index([session_id, used_at, revoked_at])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model DriverProfile {
  id              String   @id @default(cuid())
  user_id         String   @unique
  vehicle_type    String
  seats_total     Int
  parcel_capacity Int
  verified        Boolean  @default(false)
  trust_score     Int      @default(70)
  created_at      DateTime @default(now())

  user   User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  routes DriverRoute[]

  @@map("driver_profiles")
}

model DriverRoute {
  id                        String            @id @default(cuid())
  driver_id                 String
  origin_label              String
  origin_lat                Decimal           @db.Decimal(9, 6)
  origin_lng                Decimal           @db.Decimal(9, 6)
  destination_label         String
  destination_lat           Decimal           @db.Decimal(9, 6)
  destination_lng           Decimal           @db.Decimal(9, 6)
  corridor_key              String
  seats_available           Int
  parcel_capacity_available Int
  status                    DriverRouteStatus @default(inactive)
  activated_at              DateTime?
  completed_at              DateTime?

  driver DriverProfile @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  parcel_batches ParcelBatch[]
  matches Match[]
  trips Trip[]

  @@index([corridor_key])
  @@map("driver_routes")
}

model PassengerRequest {
  id                String        @id @default(cuid())
  passenger_id      String
  pickup_label      String
  pickup_lat        Decimal       @db.Decimal(9, 6)
  pickup_lng        Decimal       @db.Decimal(9, 6)
  destination_label String
  destination_lat   Decimal       @db.Decimal(9, 6)
  destination_lng   Decimal       @db.Decimal(9, 6)
  preferred_time    DateTime
  passenger_count   Int
  status            RequestStatus @default(pending)
  source            String        @default("seed")
  created_at        DateTime      @default(now())

  passenger User @relation(fields: [passenger_id], references: [id], onDelete: Cascade)
  matches Match[]
  trips Trip[]

  @@map("passenger_requests")
}

model MerchantOrder {
  id           String              @id @default(cuid())
  merchant_id  String
  pickup_label String
  pickup_lat   Decimal             @db.Decimal(9, 6)
  pickup_lng   Decimal             @db.Decimal(9, 6)
  status       MerchantOrderStatus @default(submitted)
  created_at   DateTime            @default(now())

  merchant User     @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  parcels  Parcel[]
  parcel_batches ParcelBatch[]
  matches Match[]
  trips Trip[]

  @@map("merchant_orders")
}

model Parcel {
  id                String       @id @default(cuid())
  order_id          String
  destination_label String
  destination_lat   Decimal      @db.Decimal(9, 6)
  destination_lng   Decimal      @db.Decimal(9, 6)
  size              String
  priority          String
  status            ParcelStatus @default(pending)
  batch_id          String?

  order MerchantOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("parcels")
}

model ParcelBatch {
  id                       String            @id @default(cuid())
  merchant_order_id        String
  driver_route_id          String?
  status                   ParcelBatchStatus @default(created)
  estimated_distance_saved Decimal           @db.Decimal(10, 2)
  explanation              String            @db.Text
  created_at               DateTime          @default(now())

  merchant_order MerchantOrder @relation(fields: [merchant_order_id], references: [id], onDelete: Cascade)
  driver_route   DriverRoute?   @relation(fields: [driver_route_id], references: [id], onDelete: SetNull)
  matches        Match[]
  trips          Trip[]

  @@map("parcel_batches")
}

model Match {
  id                   String      @id @default(cuid())
  driver_route_id      String
  passenger_request_id String?
  merchant_order_id    String?
  parcel_batch_id      String?
  score                Decimal     @db.Decimal(5, 4)
  method               String
  explanation          String      @db.Text
  scoring_breakdown    Json
  status               MatchStatus @default(proposed)
  created_at           DateTime    @default(now())

  driver_route      DriverRoute       @relation(fields: [driver_route_id], references: [id], onDelete: Cascade)
  passenger_request PassengerRequest? @relation(fields: [passenger_request_id], references: [id], onDelete: Cascade)
  merchant_order    MerchantOrder?    @relation(fields: [merchant_order_id], references: [id], onDelete: Cascade)
  parcel_batch      ParcelBatch?      @relation(fields: [parcel_batch_id], references: [id], onDelete: SetNull)

  @@map("matches")
}

model ComparisonRun {
  id                         String   @id @default(cuid())
  scenario_key               String
  masari_trips               Int
  nearest_driver_trips       Int
  masari_estimated_distance  Decimal  @db.Decimal(10, 2)
  nearest_estimated_distance Decimal  @db.Decimal(10, 2)
  masari_estimated_cost      Decimal  @db.Decimal(10, 2)
  nearest_estimated_cost     Decimal  @db.Decimal(10, 2)
  parcel_batching_benefit    String   @db.Text
  driver_utilization         Decimal  @db.Decimal(5, 2)
  winner                     String
  created_at                 DateTime @default(now())

  @@map("comparison_runs")
}

model Trip {
  id                   String     @id @default(cuid())
  driver_id            String
  driver_route_id      String
  passenger_request_id String?
  merchant_order_id    String?
  parcel_batch_id      String?
  status               TripStatus @default(created)
  started_at           DateTime?
  completed_at         DateTime?
  created_at           DateTime   @default(now())

  driver_route      DriverRoute       @relation(fields: [driver_route_id], references: [id], onDelete: Cascade)
  passenger_request PassengerRequest? @relation(fields: [passenger_request_id], references: [id], onDelete: SetNull)
  merchant_order    MerchantOrder?    @relation(fields: [merchant_order_id], references: [id], onDelete: SetNull)
  parcel_batch      ParcelBatch?      @relation(fields: [parcel_batch_id], references: [id], onDelete: SetNull)
  location_events   LocationEvent[]

  @@index([driver_id])
  @@map("trips")
}

model LocationEvent {
  id          String   @id @default(cuid())
  trip_id     String
  driver_id   String
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  source      String
  sequence    Int
  recorded_at DateTime @default(now())

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id, sequence])
  @@map("location_events")
}

model DemoScenario {
  id           String   @id @default(cuid())
  scenario_key String   @unique
  corridor_key String
  description  String   @db.Text
  seed_version String
  created_at   DateTime @default(now())

  @@map("demo_scenarios")
}

model AuditEvent {
  id          String      @id @default(cuid())
  user_id     String?
  action      AuditAction
  entity_type String?
  entity_id   String?
  metadata    Json?
  created_at  DateTime    @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([user_id])
  @@map("audit_events")
}
