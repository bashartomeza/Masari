{
  "name": "@masari/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env ../../node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration:multi-route": "node dist/scripts/multiRouteIntegration.js",
    "test:integration:canonical-matching": "node dist/scripts/canonicalMatchingIntegration.js",
    "test:integration:canonical-shared": "node dist/scripts/canonicalSharedMatchingIntegration.js",
    "test:integration:reset-matrix": "node dist/scripts/demoResetGateIntegration.js",
    "test:integration:legacy-online": "node dist/scripts/legacyOnlineStateIntegration.js",
    "test:integration:passenger-trip-association": "node dist/scripts/passengerTripAssociationIntegration.js",
    "canonical:match": "node dist/scripts/canonicalMatchingCommand.js",
    "canonical:shared": "node dist/scripts/canonicalSharedMatchingCommand.js",
    "maps:bakeoff": "tsx src/scripts/routeProviderBakeoff.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "libphonenumber-js": "1.13.9",
    "mariadb": "3.4.5",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.1.0",
    "@types/supertest": "7.2.0",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
