APP_ENV="staging"
ENABLE_DEMO_FEATURES="false"
APP_RELEASE="<immutable-staging-release-identifier>"
DATABASE_URL="mysql://<user>:<password>@<trusted-staging-host>:3306/masari"
JWT_SECRET="<at-least-32-random-characters>"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"
REFRESH_TOKEN_PEPPER="<at-least-32-random-characters-separate-from-jwt>"
CORS_ORIGINS="https://staging-admin.masari.example"
TRUST_PROXY="<none-or-known-proxy-hop-count>"
LOG_LEVEL="info"
READINESS_TIMEOUT_MS="2000"
RATE_LIMIT_GLOBAL_WINDOW_MS="900000"
RATE_LIMIT_GLOBAL_MAX="300"
RATE_LIMIT_LOGIN_WINDOW_MS="900000"
RATE_LIMIT_LOGIN_MAX="10"
PORT="3000"
