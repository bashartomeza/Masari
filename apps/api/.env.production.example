# Use staging or production. Both disable demo capabilities.
APP_ENV="production"
ENABLE_DEMO_FEATURES="false"
APP_RELEASE="<immutable-release-identifier>"
DATABASE_URL="mysql://<user>:<password>@<trusted-host>:3306/masari"
JWT_SECRET="<at-least-32-random-characters>"
CORS_ORIGINS="https://admin.masari.example"
PORT="3000"
