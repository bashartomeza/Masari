# Local development without demo capabilities.
APP_ENV="local"
ENABLE_DEMO_FEATURES="false"
DEMO_RESET_ALLOWED_DATABASES=""
ROUTE_MANAGEMENT_ENABLED="false"
MULTI_ROUTE_ENTRY_ENABLED="false"
MULTI_ROUTE_MATCHING_ENABLED="false"
CANONICAL_TRIP_CREATION_ENABLED="false"
CANONICAL_SHARED_TRIPS_ENABLED="false"
CANONICAL_SHARED_TRIP_MOBILE_ENABLED="false"
ROUTE_MAPS_ENABLED="false"
ROUTE_PROVIDER="disabled"
ROUTE_PROVIDER_CONNECT_TIMEOUT_MS="1000"
ROUTE_PROVIDER_REQUEST_TIMEOUT_MS="4000"
ROUTE_PROVIDER_MAX_RETRIES="1"
ROUTE_PROVIDER_CACHE_TTL_SECONDS="0"
ROUTE_PROVIDER_RATE_LIMIT_WINDOW_MS="900000"
ROUTE_PROVIDER_RATE_LIMIT_MAX="20"
DATABASE_URL="mysql://<user>:<password>@localhost:3306/masari"
JWT_SECRET="<at-least-32-random-characters>"
ACCESS_TOKEN_TTL_SECONDS="28800"
REFRESH_TOKEN_TTL_DAYS="30"
REFRESH_TOKEN_PEPPER="<at-least-32-random-characters-separate-from-jwt>"
CORS_ORIGINS="http://localhost:5173"
TRUST_PROXY="none"
LOG_LEVEL="info"
PORT="3000"
INVITATIONS_ENABLED="false"
PUBLIC_ONBOARDING_ENABLED="false"
OTP_PROVIDER="disabled"
INVITATION_CODE_PEPPER="<separate-random-secret-at-least-32-characters>"
INVITATION_CODE_KEY_VERSION="1"
PHONE_DIGEST_PEPPER="<separate-random-secret-at-least-32-characters>"
PHONE_DIGEST_KEY_VERSION="1"
OTP_CODE_PEPPER="<separate-random-secret-at-least-32-characters>"
OTP_CODE_KEY_VERSION="1"
ONBOARDING_SESSION_PEPPER="<separate-random-secret-at-least-32-characters>"
ONBOARDING_SESSION_KEY_VERSION="1"
IDEMPOTENCY_KEY_PEPPER="<separate-random-secret-at-least-32-characters>"
IDEMPOTENCY_KEY_VERSION="1"
IDEMPOTENCY_PAYLOAD_PEPPER="<separate-random-secret-at-least-32-characters>"
IDEMPOTENCY_PAYLOAD_KEY_VERSION="1"
ABUSE_KEY_PEPPER="<separate-random-secret-at-least-32-characters>"
ABUSE_KEY_VERSION="1"
INVITATION_EXPIRY_DAYS="7"
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_RESENDS="3"
OTP_MAX_SENDS_PER_PHONE_DAY="5"
ADMIN_INVITATION_MAX_PER_HOUR="20"
ONBOARDING_ATTEMPT_TTL_SECONDS="1800"
ONBOARDING_REGISTRATION_GRANT_TTL_SECONDS="900"
ONBOARDING_CONTINUATION_TTL_SECONDS="1800"
ONBOARDING_PENDING_STATUS_TTL_DAYS="7"
ONBOARDING_TEST_LEGAL_FIXTURES_ENABLED="false"

# Auth rollout: endpoint audiences must be distinct. Leave optional IDs unset
# to disable their endpoints. Do not use GOOGLE_OAUTH_CLIENT_IDS for new Auth.
# GOOGLE_MOBILE_SERVER_CLIENT_ID="<mobile-server-oauth-client-id>"
# GOOGLE_ADMIN_WEB_CLIENT_ID="<admin-web-oauth-client-id>"
GOOGLE_PASSENGER_SIGNUP_MODE="disabled"
GOOGLE_PASSENGER_ALLOWLIST_HMACS=""
# Required for email actions and Google signup; distinct random server secret.
# AUTH_ACTION_TOKEN_PEPPER="<separate-random-secret-at-least-32-characters>"
AUTH_ACTION_TOKEN_KEY_VERSION="1"
# Staging/production signup stays blocked until approved email/SMS delivery
# adapters, current legal releases and runtime evidence are integrated.

# Passenger AI assistant provider. ASSISTANT_PROVIDER picks which key/model/timeout
# applies; leave the chosen provider's key empty to run the assistant inert
# (it then returns no fabricated result).
XAI_API_KEY=""
XAI_MODEL="grok-4.6"
XAI_TIMEOUT_MS="15000"
ASSISTANT_PROVIDER="groq"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
GEMINI_TIMEOUT_MS="15000"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_TIMEOUT_MS="15000"
